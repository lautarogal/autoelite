        <task id="0" uid="13df17965fc94aafb8d9e502f371c9fc" name="Definir objetivo" meeting="false" start="2026-04-17" duration="28" complete="0" expand="true">
            <notes><![CDATA[Definir objetivo: Pensar en como desarrollar un sistema web para tal concesionaria de autos que permita mostrar los vehículos disponibles, facilitar la búsqueda de información y mejorar la comunicación entre los clientes y la concesionaria. 
 
]]></notes>
            <depend id="1" type="2" difference="0" hardness="Strong"/>
        </task>
        <task id="1" uid="e7399507befa4d62bc193d90b659eb75" name="Investigar ejemplos" meeting="false" start="2026-05-29" duration="14" complete="0" expand="true">
            <notes><![CDATA[Investigar ejemplos: En este punto nos ponemos a investigar ejemplos de otros diseños de sistemas ya echos.]]></notes>
            <depend id="2" type="2" difference="0" hardness="Strong"/>
        </task>
        <task id="2" uid="3907e95b19b2485aa9aafa5420ca1e2c" name="Entrevistas" meeting="false" start="2026-06-18" duration="14" complete="0" expand="true">
            <notes><![CDATA[Entrevista: Realizar una entrevista con el dueño de la concesionaria para conocer las necesidades del sistema y definir las funciones que tendrá la página web, como mostrar autos disponibles, precios, imágenes y medios de contacto. 
]]></notes>
            <depend id="3" type="2" difference="0" hardness="Strong"/>
        </task>
        <task id="3" uid="138a6839c3574793a4f086ba31b058f6" name="Reunir contenido" meeting="false" start="2026-07-08" duration="14" complete="0" expand="true">
            <notes><![CDATA[Reunir contenido: Ya echa la entrevista, quedaria recopilar contenido e información de los autos de la concesionaria 
]]></notes>
            <depend id="4" type="2" difference="0" hardness="Strong"/>
        </task>
        <task id="4" uid="8ef4a380456342298ce4799fafefd246" name="Diseñar estructura y stack" meeting="false" start="2026-07-29" duration="21" complete="0" expand="true">
            <notes><![CDATA[Diseñar estructuras: Diseñar la estructura de la pagina web de la concesionaria y seleccionar las tecnologías (stack) que se utilizarán para su desarrollo. 
]]></notes>
            <depend id="5" type="2" difference="0" hardness="Strong"/>
        </task>
        <task id="5" uid="00b524d4dad24548b1b62ff314d4ea8f" name="Crear base de datos" meeting="false" start="2026-08-27" duration="14" complete="0" expand="true">
            <notes><![CDATA[Crear base de datos: Crear y diseñar la base de datos para almacenar la información brindada de los vehículos, clientes y consultas de la concesionaria. 
]]></notes>
            <depend id="10" type="2" difference="0" hardness="Strong"/>
        </task>
